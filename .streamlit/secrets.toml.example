# Streamlit Community Cloud: paste this (with your real values) into the app's
# Settings -> Secrets box. Locally, a .env with ODDS_API_KEY also works.
ODDS_API_KEY = "your_the_odds_api_v4_key_here"

# --- "Request a desktop scan" (pages/5_Arbitrage.py) ------------------------
# This host cannot fetch odds: DraftKings and FanDuel refuse datacenter IPs.
# The button writes data/scan_request.json to the repo; scripts/arb_agent.py,
# running on your machine in Connecticut, polls for it, scrapes, and pushes a
# fresh snapshot back.
#
# GITHUB_TOKEN must be a fine-grained personal access token, scoped to THIS
# repository only, with exactly one permission:
#     Repository permissions -> Contents -> Read and write
# Nothing else. It can commit to this repo, so give it no wider reach than that
# -- and never put it in .env or the repo itself, only in the Secrets box.
# github.com/settings/personal-access-tokens/new
GITHUB_REPO = "raefski/edge_search"
GITHUB_TOKEN = "github_pat_..."
