# Desktop side of the phone-triggered scan.
#   mkdir -p ~/.config/systemd/user
#   cp deploy/arb-agent.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now arb-agent
#   systemctl --user status arb-agent      # and: journalctl --user -u arb-agent -f
#
# WSL2 runs systemd, but a user service stops when the last session for that
# user ends. To keep it alive with no terminal open:
#   sudo loginctl enable-linger $USER
[Unit]
Description=Arbitrage scan agent (answers scan requests from the Streamlit app)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/edge_search
# --odds-profiles makes one phone request refresh all three products in ONE
# commit: the arbitrage snapshot, plus the DFS and pick'em price snapshots the
# cloud pages read (Streamlit Cloud cannot scrape and cannot see data/odds.db).
# Publishing those here rather than on the collection timers is what keeps this
# public repo from growing ~10GB a year -- see arb_agent.py's docstring.
ExecStart=/usr/bin/env python3 scripts/arb_agent.py --interval 30 \
          --odds-profiles dfs_mlb pickem_nfl
Restart=always
RestartSec=15
# The scan is network-bound and polite by design; keep it off the CPU governor's
# radar so it never competes with anything interactive.
Nice=10

[Install]
WantedBy=default.target
