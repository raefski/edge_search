# Collect today's NBA DFS YouTube + podcast buzz and push it for the app
# (scripts/buzz_nba.py). Home machine only: YouTube is reached from a
# residential IP. The NBA build folds it into GPP ownership (BUZZ_BETA).
#
#   cp deploy/buzz-nba-publish.service deploy/buzz-nba-publish.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now buzz-nba-publish.timer
[Unit]
Description=Collect and publish NBA DFS buzz (YouTube + podcasts)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/edge_search
ExecStart=/usr/bin/env python3 scripts/buzz_nba.py --push
Restart=no
Nice=10
TimeoutStartSec=1800
