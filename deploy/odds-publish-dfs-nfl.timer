# Push a fresh NFL props snapshot to the cloud app -- all week, not just Sunday.
#
# FOUND LIVE 2026-09-12: the first version of this timer only ran Sunday
# 08:00-13:00 ET plus Thursday evenings, on the theory that Sunday morning was
# "the" pre-lock window. The user opened the phone app Saturday at 8:39 PM ET
# and saw a snapshot 333 minutes old -- the one manual push from that
# afternoon's build session -- because nothing was scheduled to run between
# Saturday and Sunday 8 AM. The local store was fine (a scrape 4 minutes
# earlier); the gap was entirely in when this timer chose to PUSH.
#
# Lines move all week and people check lineups all week, not only in the hour
# before a lock. So there are now two layers:
#
#   1. A BASELINE every 2 hours, every day, 7 AM - 11 PM local -- so the phone
#      is never more than ~2h (+ RandomizedDelaySec) stale whenever it is
#      opened, any day.
#   2. DENSE 30-minute coverage in the run-up to each real DK lock: Thursday
#      Night Football (~8:15 PM ET), the Sunday early slate (1:00 PM ET), the
#      Sunday late-afternoon slate (~4:05/4:25 PM ET), Sunday Night Football
#      (~8:20 PM ET), and Monday Night Football (~8:15 PM ET) -- this is where
#      inactives land and props move fastest, so it stays denser than the
#      baseline rather than replacing it.
#
# Cost: roughly 100-110 pushes/week at ~210KB each, ~20MB/week. That is a very
# different scale from the hourly-collector push this repo has deliberately
# avoided elsewhere (data/odds.db accumulates FAR more often than this profile
# publishes) -- see odds-collect@.service's own docstring on why THOSE stay
# push-free. This timer is the one place freshness on the phone actually
# depends on a push landing, so it is allowed to cost more.
#
#   cp deploy/odds-publish@.service deploy/odds-publish-*.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now odds-publish-dfs-nfl.timer
#   systemctl --user list-timers 'odds-*'
[Unit]
Description=Publish NFL DFS props snapshot for the cloud app
[Timer]
# The instance name IS the profile -- without this the timer looks for a
# service matching its own name, which does not exist (caught on install).
Unit=odds-publish@dfs_nfl.service
# OnCalendar is LOCAL time, which is what this machine runs on, so every line
# below tracks the DST shift the NFL season crosses in November for free.

# 1. Baseline: every 2 hours, every day, waking hours.
# NB: the step belongs on the HOUR field (07..23/2:00:00). Putting it on the
# minute field instead (07..23:00/2:00, the form this line had 2026-09-12 to
# 2026-09-14) fires every 2 MINUTES all day -- caught when it had put 352
# commits on main in one day instead of ~9, hammering DraftKings/FanDuel with
# a redundant NFL scrape every ~90s and starving the live arb scan of the same
# endpoints. Verify any edit here with `systemd-analyze calendar '<expr>'`
# before installing it.
OnCalendar=*-*-* 07..23/2:00:00

# 2. Dense pre-lock windows, 30 minutes apart. Each trailing comment used to
# sit on the same line as its OnCalendar= -- systemd's unit parser does not
# support inline trailing comments, so the whole line failed to parse and
# every one of these five was silently dropped (caught alongside the baseline
# bug above; `systemd-analyze verify` on this file names the failing lines).
# Comments now live above the directive they describe, the only form the
# parser accepts.
# TNF locks ~8:15 PM ET
OnCalendar=Thu *-*-* 18..20:00/30:00
# early slate locks 1:00 PM ET
OnCalendar=Sun *-*-* 08..13:00/30:00
# late-afternoon slate, ~4:05/4:25 PM ET
OnCalendar=Sun *-*-* 15..17:00/30:00
# SNF locks ~8:20 PM ET
OnCalendar=Sun *-*-* 19..21:00/30:00
# MNF locks ~8:15 PM ET
OnCalendar=Mon *-*-* 19..21:00/30:00

RandomizedDelaySec=60
Persistent=true
[Install]
WantedBy=timers.target
